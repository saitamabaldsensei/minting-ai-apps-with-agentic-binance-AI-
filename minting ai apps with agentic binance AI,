pragma solidity ^0.8.20;

contract AgenticAIMint {

    string public name = "Agentic Binance AI";
    string public symbol = "ABAI";

    uint256 public totalSupply;
    uint256 public mintPrice = 0.001 ether;
    uint256 public maxSupply = 1000;

    address public owner;

    struct AgentNFT {
        uint256 tokenId;
        address creator;
        string agentName;
        string metadataURI;
        uint256 createdAt;
    }

    mapping(uint256 => AgentNFT) public agents;
    mapping(uint256 => address) public ownerOf;

    event AgentMinted(
        uint256 indexed tokenId,
        address indexed creator,
        string agentName
    );

    constructor() {
        owner = msg.sender;
    }

    function mintAgent(
        string memory _agentName,
        string memory _metadataURI
    ) public payable {

        require(msg.value >= mintPrice, "Insufficient payment");
        require(totalSupply < maxSupply, "Max supply reached");

        totalSupply++;

        uint256 tokenId = totalSupply;

        agents[tokenId] = AgentNFT(
            tokenId,
            msg.sender,
            _agentName,
            _metadataURI,
            block.timestamp
        );

        ownerOf[tokenId] = msg.sender;

        emit AgentMinted(
            tokenId,
            msg.sender,
            _agentName
        );
    }

    function getAgent(
        uint256 _tokenId
    ) public view returns (AgentNFT memory) {

        return agents[_tokenId];
    }

    function setMintPrice(
        uint256 _newPrice
    ) public {

        require(msg.sender == owner, "Only owner");

        mintPrice = _newPrice;
    }

    function withdraw() public {

        require(msg.sender == owner, "Only owner");

        payable(owner).transfer(address(this).balance);
    }
}
